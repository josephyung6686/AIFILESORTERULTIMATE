{
  "_": "Lifted from planning/deferred-catalogues/01-tool-producer-strings.json with its provenance wrappers removed and its provenance kept. P6 only: nothing here may reach src/extractors/. `property_names` is FLAT because facts.discount consumes it flat -- the catalogue's grouping by format family would be a lookup keyed by format, which is the branching SS2.8 exists to prevent. Rows are in the catalogue's own evaluation order; `provenance` is `design` only where the design quote in `design_cite` contains the row's own literal value, and `proposal` everywhere else.",
  "boundary_characters": "` `, `\\t`, `,`, `;`, `:`, `/`, `(`, `)`, `-`, `_`, `.`, `+`, `&`, `®`, `™`, `©`",
  "property_names": [
    "Producer",
    "Creator",
    "Author",
    "pdf:Producer",
    "xmp:CreatorTool",
    "dc:creator",
    "creator",
    "lastModifiedBy",
    "Application",
    "AppVersion",
    "meta:generator",
    "meta:initial-creator",
    "Software",
    "ProcessingSoftware",
    "HostComputer",
    "TENC",
    "TSSE",
    "PRODID",
    "X-Mailer",
    "User-Agent"
  ],
