{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E_template response (unratified draft, 2026-09-06)",
  "description": "The one JSON object a model may return at call site E_template: 00:97's strict template shape. The payload keys are tree_design.template_schema.TEMPLATE_PAYLOAD_KEYS; P10's schema validator and llm_harness.template_validation enforce most of this, and where the two could differ the template is what the model was told. There is deliberately no key for defining or publishing a fragment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload"],
      "properties": {
        "claim_ref": {"type": "string"},
        "payload": {"$ref": "#/$defs/payload"},
        "citations": {"$ref": "#/$defs/citations"},
        "unknown": {"$ref": "#/$defs/unknown"}
      },
      "oneOf": [
        {
          "title": "propose",
          "required": ["citations"],
          "not": {"required": ["unknown"]},
          "properties": {
            "payload": {
              "required": ["domain", "allowed_fields", "fragment_refs", "dimensions",
                           "levels", "sensitivity_policy_ref", "example_label_chains"],
              "properties": {"domain": {"not": {"const": "none"}}}
            }
          }
        },
        {
          "title": "propose nothing",
          "required": ["unknown"],
          "not": {"required": ["citations"]},
          "properties": {
            "payload": {
              "required": ["domain"],
              "properties": {"domain": {"const": "none"}}
            }
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "allowed_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "fragment_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fragment_id", "fragment_version"],
            "properties": {
              "fragment_id": {"type": "string", "minLength": 1},
              "fragment_version": {"type": "integer", "minimum": 1}
            }
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "scope", "evidence_ref", "requirement", "metadata_only",
                         "order_index", "values"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "scope": {"type": "string", "enum": ["schema-field", "template-local"]},
              "evidence_ref": {"type": "string", "minLength": 1},
              "requirement": {"type": "string", "enum": ["required", "optional"]},
              "metadata_only": {"type": "boolean"},
              "order_index": {"type": "integer", "minimum": 0},
              "values": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "retrieval_justification"],
            "properties": {
              "dimension": {"type": "string", "minLength": 1},
              "retrieval_justification": {"type": "string", "minLength": 1}
            }
          }
        },
        "sensitivity_policy_ref": {"type": "string", "minLength": 1},
        "example_label_chains": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"}
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/citation"}
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ref", "why_it_supports"],
      "properties": {
        "evidence_ref": {"type": "string", "minLength": 1},
        "cited_span": {"type": "string", "minLength": 1},
        "metadata_field_name": {"type": "string", "minLength": 1},
        "why_it_supports": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["cited_span"], "not": {"required": ["metadata_field_name"]}},
        {"required": ["metadata_field_name"], "not": {"required": ["cited_span"]}}
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["insufficiency_statement"],
      "properties": {
        "insufficiency_statement": {"type": "string", "minLength": 1}
      }
    }
  }
}
