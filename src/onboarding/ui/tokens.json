{
  "meta": {
    "product": "File companion",
    "version": "1.0",
    "appearance": "White & Periwinkle",
    "platform": "macOS",
    "format": "Product-specific token map"
  },
  "color": {
    "canvas": "#FFFFFF",
    "paper": "#FFFFFF",
    "ink": "#364C84",
    "muted": "#657080",
    "folder": "#95B1EE",
    "folderHighlight": "#B6CAF4",
    "selected": "#D9E3FA",
    "suggested": "#E7F1A8",
    "border": "#E5E8EF",
    "fieldBorder": "#E0E5EE",
    "cardShade": "#F8F9FB",
    "primaryGradientStart": "#425C98",
    "primaryGradientEnd": "#364C84"
  },
  "typography": {
    "family": "SF Pro",
    "cssStack": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "roles": {
      "heading": {
        "size": 38,
        "lineHeight": 42.56,
        "weight": 600,
        "letterSpacing": -1.25
      },
      "panelTitle": {
        "size": 22,
        "lineHeight": 29.7,
        "weight": 500,
        "letterSpacing": -0.55
      },
      "body": {
        "size": 14,
        "lineHeight": 21,
        "weight": 400
      },
      "button": {
        "size": 13,
        "lineHeight": 19.5,
        "weight": 500
      },
      "fieldLabel": {
        "size": 12,
        "lineHeight": 18,
        "weight": 500
      },
      "caption": {
        "size": 11,
        "lineHeight": 17.05,
        "weight": 400
      }
    },
    "units": "px"
  },
  "space": {
    "baseScale": [
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      48
    ],
    "units": "px"
  },
  "radius": {
    "field": 11,
    "category": 19,
    "card": 20,
    "profile": 23,
    "primary": 25,
    "dialog": 27,
    "window": 28,
    "units": "px"
  },
  "stroke": {
    "whiteRim": 2,
    "fineBorder": 1,
    "focusRing": 2,
    "focusOffset": 4,
    "units": "px"
  },
  "shadow": {
    "card": "0 5px 14px #364C8408",
    "raised": "0 8px 25px #364C8409",
    "window": "0 24px 65px #364C8415, 0 2px 8px #364C840A",
    "insetRim": "inset 0 1px 0 #FFFFFF80"
  },
  "motion": {
    "stateChangeMs": 180,
    "scanPeriodMs": 2000,
    "reducedMotion": "Disable looping progress and transitions"
  },
  "components": {
    "primaryButton": {
      "height": 46,
      "minWidth": 195,
      "horizontalPadding": 22,
      "radiusToken": "radius.primary"
    },
    "textField": {
      "minHeight": 41,
      "horizontalPadding": 12,
      "radiusToken": "radius.field"
    },
    "folderTile": {
      "minHeight": 145,
      "whiteRim": 2,
      "radiusToken": "radius.card"
    },
    "touchTarget": {
      "minHeight": 44
    }
  },
  "asset": {
    "companion": "assets/glass-companion.webp",
    "preserveAlpha": true,
    "fit": "contain",
    "instancesPerView": 1
  }
}
