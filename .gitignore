__pycache__/
*.pyc
.DS_Store
*.npy
*.sqlite
venv/
.venv/
.pytest_cache/

# P1 implementation is tracked from 2026-08-19: the plan is locked and the
# walking skeleton is the integration test every later part must keep green.
*.egg-info/

# graphify build artifacts — regenerable, rebuilt by `graphify update .`
graphify-out/

# SQLite write-ahead log companions to the ignored `*.sqlite` plan database.
# They appear whenever a run is interrupted and are regenerated on the next open.
*.sqlite-wal
*.sqlite-shm

# API credentials. NEVER committed. `.env` is where a key is pasted and
# `.env.example` is the tracked template that shows which names are read.
.env
.env.*
!.env.example

# The ground-truth corpus and its labels: 215 of the owner every one of whose
# paths is a real path, and `paths` is the first entry in ALWAYS_LOCAL. This
# repo has a remote, so committing them would be egress. Kept here rather than
# in a session scratchpad so the instrument outlives the session that built it.
.groundtruth/
