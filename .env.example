# Copy this file to `.env` and paste your key in. `.env` is gitignored; this
# template is not, so no real key ever belongs in THIS file.
#
# Absent means refuse, never guess: a run with no key refuses by name and says
# what it needed. It does NOT quietly proceed without a model, because a person
# who believes a model ran when none did is being misled.

# --- a model on your own machine (no key, nothing leaves the device) ----------
#
# `00`:189-193's second operation mode: "Local extraction plus a user-installed
# local LLM for eligible dossiers." Set the two names below and the fact question
# -- what course, what school, what kind of document -- is answered by a model
# running on this computer. No account, no key, no bytes over the internet, and it
# works under every mode including `offline`, because `offline` is "No content
# leaves the device; only local rules and LOCAL MODELS may run".
#
# It is asked over loopback and nowhere else: an endpoint naming any other host is
# refused before the scan, because the audit record would otherwise say `local`
# about a call that left the machine.
#
#   ollama pull qwen3:8b        # then set the id below to `qwen3:8b`
#
# Thinking is turned OFF in the request. A model that shares one budget between
# thinking and writing spends it thinking and never starts writing -- measured on
# four real dossiers, the whole ceiling gone and zero answer characters -- so this
# is not optional and is not yours to set.
#
# WITH BOTH THIS AND A KEY SET, the local model goes first: it answers the fact
# question and the cloud models keep the questions it is not asked.

# The id of a model `ollama list` shows. Unset means no local model.
GRAPH_AGENT_LOCAL_MODEL=

# Where ollama is listening. Loopback only. Unset means http://127.0.0.1:11434
OLLAMA_BASE_URL=

# --- credentials -------------------------------------------------------------

# DeepSeek. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Defaults to DeepSeek's published endpoint when unset.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- the three tiers ---------------------------------------------------------
#
# One model per KIND OF JUDGEMENT, not one model for everything. The routing
# policy and the reasoning behind it are `planning/83-MODEL-ROUTING.md`; these
# are the names that policy resolves to, and they are named HERE rather than in
# code because which model to call is a deployment choice and `src/` picks no
# numbers and no policies.
#
# If a name below is wrong the provider rejects the call and says so. That is
# the intended failure: a wrong name must not silently fall back to another
# tier, because a cheap model answering a question the expensive one was chosen
# for is a wrong answer that looks like a right one.

# Heavy reasoning. The judgement calls where being wrong is expensive.
DEEPSEEK_MODEL_REASONING=DeepSeek-V4-Pro

# Step-by-step logic on a budget. Bounded, checkable, verification-shaped work.
DEEPSEEK_MODEL_LOGIC=DeepSeek-R1

# Speed and cost. High volume, low stakes, individually cheap to get wrong.
DEEPSEEK_MODEL_FAST=DeepSeek-V4-Flash
